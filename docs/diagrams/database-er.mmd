%% Selected logical relationships, not SQL foreign-key constraints.
%% Account/assignment relationships: database-access-er.mmd.
erDiagram
  Hospital o|--o{ ResourceProvider : "optional parent"
  Hospital ||--o{ EmergencyRequest : hospital
  ResourceProvider o|--o{ BloodRequest : "optional provider"
  ResourceProvider ||--o{ AmbulanceBooking : provider
  Hospital o|--o{ Job : "hospital or provider"
  ResourceProvider o|--o{ Job : "provider or hospital"
  Job ||--o{ JobApplication : job
  Hospital o|--o{ OrganizationApplication : "hospital or provider"
  ResourceProvider o|--o{ OrganizationApplication : "provider or hospital"
  Hospital {
    ObjectId _id PK
    string name
    Point location
    string approvalStatus
  }
  ResourceProvider {
    ObjectId _id PK
    string kind
    ObjectId hospital FK "optional"
    Point location
  }
  EmergencyRequest {
    ObjectId _id PK
    ObjectId hospital FK
    ObjectId user "optional User reference"
    string status
  }
  BloodRequest {
    ObjectId _id PK
    ObjectId provider FK "optional"
    ObjectId user "optional User reference"
    string type
    string status
  }
  AmbulanceBooking {
    ObjectId _id PK
    ObjectId provider FK
    ObjectId user "optional User reference"
    string status
  }
  Job {
    ObjectId _id PK
    ObjectId hospital FK "or provider"
    ObjectId provider FK "or hospital"
    ObjectId createdBy "User reference"
    string status
  }
  JobApplication {
    ObjectId _id PK
    ObjectId job FK
    ObjectId applicant "User reference"
    string status
  }
  OrganizationApplication {
    ObjectId _id PK
    ObjectId hospital FK "or provider"
    ObjectId provider FK "or hospital"
    ObjectId applicant "User reference"
    string status
  }
