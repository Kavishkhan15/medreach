{
  "name": "@medreach/backend",
  "version": "0.1.0",
  "private": true,
  "description": "Shared Express + MongoDB API. Identical for all three CSS-framework variants \u2014 the constant in the experiment.",
  "type": "module",
  "main": "src/server.js",
  "engines": {
    "node": ">=22.19.0"
  },
  "scripts": {
    "dev": "node --watch src/server.js",
    "lint": "eslint --config eslint.config.mjs src scripts",
    "start": "node src/server.js",
    "seed": "node scripts/seed.js",
    "seed:mumbai": "node scripts/seed.js && node scripts/syncHospitalResources.js",
    "seed:product-demo": "node scripts/seedProductDemo.js --demo",
    "sync:hospital-resources": "node scripts/syncHospitalResources.js",
    "migrate:auth-security": "node scripts/migrateAuthSecurity.js",
    "migrate:reliability-indexes": "node scripts/migrateReliabilityIndexes.js",
    "test": "NODE_ENV=test EMAIL_ENABLED=false node --test --test-concurrency=1",
    "smoke:auth": "node scripts/smokeAuthSecurity.js",
    "worker:notification": "node src/workers/notification.js",
    "worker:expiry": "node src/workers/expiry.js",
    "worker:recovery": "node src/workers/recovery.js",
    "workers:local": "bash scripts/runLocalWorkers.sh",
    "audit:data": "node scripts/auditBackendData.js",
    "audit:integrity": "node scripts/reviewDataIntegrity.js",
    "integrity:review": "node scripts/runIntegrityMigration.js --dry-run",
    "migrate:production-indexes": "node scripts/migrateProductionIndexes.js",
    "migrate:adoption-indexes": "node scripts/migrateAdoptionIndexes.js",
    "migrate:reliability-release": "node scripts/migrateReliabilityReleaseIndexes.js",
    "rehearse:sustained": "node scripts/rehearseSustainedReliability.js",
    "staging:local": "node scripts/runLocalStaging.js",
    "audit:evidence": "node scripts/inventoryEvidenceArtifacts.js",
    "profile:hospitals": "node scripts/profileHospitalQueries.js",
    "backup:create-encrypted": "node scripts/verifiedBackup.js create",
    "backup:verify-encrypted": "node scripts/verifiedBackup.js verify",
    "backup:restore-retained": "node scripts/restoreRetainedBackup.js",
    "demo:inventory": "node scripts/createInventoryDemo.js",
    "migrate:operations-indexes": "node scripts/migrateOperationsIndexes.js",
    "backup:verify-local": "node scripts/verifyLocalRestore.js"
  },
  "dependencies": {
    "bcryptjs": "^2.4.3",
    "compression": "^1.8.2",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.21.0",
    "express-rate-limit": "^7.4.0",
    "express-validator": "^7.2.0",
    "helmet": "^7.1.0",
    "jsonwebtoken": "^9.0.2",
    "mongoose": "^8.7.0",
    "nodemailer": "^10.1.4",
    "undici": "8.12.3"
  },
  "devDependencies": {
    "supertest": "^7.0.0"
  }
}
