{
  "name": "@medreach/backend",
  "version": "0.1.0",
  "private": true,
  "description": "Shared Express + MongoDB API. Identical for all three CSS-framework variants — the constant in the experiment.",
  "type": "module",
  "main": "src/server.js",
  "scripts": {
    "dev": "node --watch src/server.js",
    "start": "node src/server.js",
    "seed": "node scripts/seed.js",
    "seed:mumbai": "node scripts/seed.js && node scripts/seedCrawlerSources.js && node scripts/syncHospitalResources.js",
    "seed:crawler-sources": "node scripts/seedCrawlerSources.js",
    "seed:product-demo": "node scripts/seedProductDemo.js --demo",
    "sync:hospital-resources": "node scripts/syncHospitalResources.js",
    "migrate:auth-security": "node scripts/migrateAuthSecurity.js",
    "migrate:reliability-indexes": "node scripts/migrateReliabilityIndexes.js",
    "test": "NODE_ENV=test EMAIL_ENABLED=false node --test --test-concurrency=1",
    "smoke:auth": "node scripts/smokeAuthSecurity.js"
  },
  "dependencies": {
    "bcryptjs": "^2.4.3",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.21.0",
    "express-rate-limit": "^7.4.0",
    "express-validator": "^7.2.0",
    "helmet": "^7.1.0",
    "jsonwebtoken": "^9.0.2",
    "mongoose": "^8.7.0",
    "nodemailer": "^10.0.9",
    "undici": "8.10.0"
  },
  "devDependencies": {
    "supertest": "^7.0.0"
  }
}
