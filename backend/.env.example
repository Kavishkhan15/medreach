# Copy to .env and fill in. NEVER commit the real .env.
NODE_ENV=development
PORT=4000

# MongoDB — local or Atlas. Full CRUD requires a running MongoDB.
MONGO_URI=mongodb://127.0.0.1:27017/medreach

# Auth
JWT_SECRET=change-me-to-a-long-random-string
# Access JWTs are intentionally short lived. JWT_EXPIRES remains a legacy alias.
ACCESS_TOKEN_EXPIRES=15m
REFRESH_TOKEN_EXPIRES_DAYS=30
OAUTH_STATE_EXPIRES_MINUTES=10
# Use none for HTTPS deployments whose frontend and API are on different sites.
COOKIE_SAME_SITE=lax

# Google OAuth 2.0 / OpenID Connect. Never put these values in frontend env.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK_URL=http://localhost:4000/api/auth/google/callback

# Frontend origins allowed to call the API (comma-separated)
CORS_ORIGINS=http://localhost:3000,http://localhost:3001,http://localhost:3002
PUBLIC_APP_URL=http://localhost:3000

# SMTP: disabled mode records delivery intent without sending. Configure these
# variables and set EMAIL_ENABLED=true to enable any standard SMTP provider.
EMAIL_ENABLED=false
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
SMTP_FROM_NAME=MedReach
SMTP_CONNECTION_TIMEOUT_MS=8000

# Optional route-duration provider. "none" returns distance only, no ETA.
ROUTING_PROVIDER=none
ROUTING_BASE_URL=
ROUTING_API_KEY=

# Source-specific crawler scheduler (3-minute due-source check, not a 3-minute crawl).
CRAWLER_SCHEDULER_ENABLED=true
CRAWLER_SCHEDULER_TICK_MS=180000

# Optional evidence-refinement queue. Never writes verified facts directly.
GEMINI_ENABLED=false
GEMINI_MODEL=gemini-2.5-flash
GEMINI_API_KEY=

# AI Assistant provider — optional. Defaults to a deterministic, zero-config
# rule-based provider when unset, so the assistant works with no external AI
# service at all. Set these only to plug in a real LLM provider; the UI and
# API contract never change when you do.
# AI_PROVIDER=rule_based   # rule_based (default) | openai | gemini
# AI_API_KEY=
# AI_MODEL=

# Example: Google Gemini
# AI_PROVIDER=gemini
# AI_API_KEY=<Gemini API key>
# AI_MODEL=gemini-2.5-flash

# Example: OpenAI
# AI_PROVIDER=openai
# AI_API_KEY=<OpenAI API key>
# AI_MODEL=gpt-4o-mini
