# Copy to .env and fill in. NEVER commit the real .env.
NODE_ENV=development
PORT=4000

# MongoDB — local or Atlas. Full CRUD requires a running MongoDB.
MONGO_URI=mongodb://127.0.0.1:27017/medreach
# For Railway, set MONGODB_URI to the verified Atlas dataset URI in service variables.

# Auth
JWT_SECRET=change-me-to-a-long-random-string
# Access JWTs are intentionally short lived. JWT_EXPIRES remains a legacy alias.
ACCESS_TOKEN_EXPIRES=15m
REFRESH_TOKEN_EXPIRES_DAYS=30
# Use none for HTTPS deployments whose frontend and API are on different sites.
COOKIE_SAME_SITE=lax

# Frontend origins allowed to call the API (comma-separated)
CORS_ORIGINS=http://localhost:3000,http://localhost:3001,http://localhost:3002
PUBLIC_APP_URL=http://localhost:3000

# Email Configuration (Google / Gmail or Standard SMTP)
# Set EMAIL_ENABLED=true to enable email delivery. When disabled, delivery intent
# is recorded in EmailDelivery without network traffic.
EMAIL_ENABLED=false
EMAIL_PROVIDER=google
# Railway Free/Trial/Hobby: use Resend's HTTPS API instead of SMTP.
# Verify the sending domain in Resend before enabling this configuration.
# EMAIL_PROVIDER=resend
# RESEND_API_KEY=
# RESEND_FROM=notifications@mail.medreachforyou.com

# Google / Gmail SMTP Setup:
# 1. Enable 2-Step Verification on your Google Account: https://myaccount.google.com/security
# 2. Generate a 16-character App Password at: https://myaccount.google.com/apppasswords
# 3. Enter your Gmail address and generated App Password below:
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
SMTP_FROM_NAME=MedReach
SMTP_CONNECTION_TIMEOUT_MS=8000

# Optional route-duration provider. "none" returns distance only, no ETA.
ROUTING_PROVIDER=none
ROUTING_BASE_URL=
ROUTING_API_KEY=

# Optional evidence-refinement queue. Never writes verified facts directly.
GEMINI_ENABLED=false
GEMINI_MODEL=gemini-2.5-flash
GEMINI_API_KEY=

# AI Assistant provider — optional. Defaults to a deterministic, zero-config
# rule-based provider when unset, so the assistant works with no external AI
# service at all. Set these only to plug in a real LLM provider; the UI and
# API contract never change when you do.
# AI_PROVIDER=rule_based   # rule_based (default) | openai | gemini
# AI_API_KEY=
# AI_MODEL=

# Example: Google Gemini
# AI_PROVIDER=gemini
# AI_API_KEY=<Gemini API key>
# AI_MODEL=gemini-2.5-flash

# Example: OpenAI
# AI_PROVIDER=openai
# AI_API_KEY=<OpenAI API key>
# AI_MODEL=gpt-4o-mini

# Direct connections by default. Set trusted proxy IP/CIDR(s) in hosted deployments.
# A hop count is safe only if every incoming path traverses that many trusted proxies.
TRUST_PROXY=false
