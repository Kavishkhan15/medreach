{
  "$schema": "https://railway.com/railway.schema.json",
  "build": {
    "builder": "RAILPACK"
  },
  "deploy": {
    "startCommand": "node backend/src/workers/recovery.js",
    "numReplicas": 1,
    "sleepApplication": false,
    "drainingSeconds": 35,
    "restartPolicyType": "ON_FAILURE",
    "restartPolicyMaxRetries": 5
  }
}
