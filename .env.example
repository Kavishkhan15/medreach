# MedReach Monorepo Environment Variables Example
# Copy to appropriate .env files. NEVER commit real secrets or API keys.

# =============================================================================
# Frontend (variants/bootstrap/.env.local)
# =============================================================================
NEXT_PUBLIC_API_URL=http://localhost:4000

# Google Maps JavaScript API Key (required for interactive map on /map)
# 1. Enable ONLY "Maps JavaScript API" in Google Cloud Console.
# 2. Restrict to HTTP referrers (e.g. http://localhost:3000/*).
# 3. If omitted, /map displays an informative setup fallback without crashing.
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=

# Optional: Map ID for cloud-styled maps (defaults to "DEMO_MAP_ID")
# NEXT_PUBLIC_GOOGLE_MAPS_MAP_ID=

# =============================================================================
# Backend (backend/.env)
# =============================================================================
NODE_ENV=development
PORT=4000
MONGO_URI=mongodb://127.0.0.1:27017/medreach

# Auth
JWT_SECRET=change-me-to-a-long-random-string
ACCESS_TOKEN_EXPIRES=15m
REFRESH_TOKEN_EXPIRES_DAYS=30
COOKIE_SAME_SITE=lax

# Allowed origins
CORS_ORIGINS=http://localhost:3000,http://localhost:3001,http://localhost:3002
PUBLIC_APP_URL=http://localhost:3000

# Email Configuration (Google / Gmail or Standard SMTP)
EMAIL_ENABLED=false
EMAIL_PROVIDER=google
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
SMTP_FROM_NAME=MedReach
SMTP_CONNECTION_TIMEOUT_MS=8000

# Routing & Crawler
ROUTING_PROVIDER=none
CRAWLER_SCHEDULER_ENABLED=true
CRAWLER_SCHEDULER_TICK_MS=180000

# Direct connections by default. Set trusted proxy IP/CIDR(s) in hosted deployments.
# A hop count is safe only if every incoming path traverses that many trusted proxies.
TRUST_PROXY=false
